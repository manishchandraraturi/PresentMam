# PresentMam API Environment Variables
# See ARCHITECTURE.md section 11

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase (Server-only credentials)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-jwks-url

# Supabase Storage (Private bucket for evidence files)
STORAGE_BUCKET=evidence-files

# Vision LLM Provider (Interface: fake, gemini; model name must never be hard-coded)
VISION_PROVIDER=fake
VISION_API_KEY=your-vision-api-key
VISION_MODEL=your-vision-model-name

# Email Provider (Interface: resend, smtp, fake)
EMAIL_PROVIDER=fake
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=notifications@your-college-domain.edu

# Authorization & Routing (Domain is configurable and unconfirmed)
ALLOWED_EMAIL_DOMAINS=your-college-domain.edu
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment mode (dev, test, prod)
ENV=dev
